{
  "name": "tehuti-cli",
  "version": "1.2.1",
  "description": "Tehuti CLI — Ink/React terminal coding assistant with OpenAI-compatible agent loop, ~66 native tools, MCP, and OpenCode-default provider.",
  "type": "module",
  "bin": {
    "tehuti": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "start:ink": "tsx src/index.ts",
    "build:rust": "cd rust-core && npx -y -p @napi-rs/cli napi build --platform --release",
    "build": "npm run build:rust && tsup",
    "postbuild": "cp rust-core/*.node dist/ || true",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "openrouter",
    "mcp",
    "agent",
    "code-generation",
    "tehuti"
  ],
  "author": "Osiris Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Osiris-Labs/Tehuti-CLI"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@aiter/core": "^0.1.10",
    "@ink-tools/ink-mouse": "^2.1.0",
    "@inquirer/prompts": "^8.2.1",
    "@lvce-editor/ripgrep": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@types/turndown": "^5.0.6",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "clean-stack": "^5.2.0",
    "clipboardy": "^5.3.1",
    "commander": "^14.0.0",
    "conf": "^15.1.0",
    "consola": "^3.4.0",
    "cosmiconfig": "^9.0.0",
    "diff": "^8.0.1",
    "dotenv": "^16.4.7",
    "exa-js": "^2.4.0",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^21.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "fuse.js": "^7.1.0",
    "handle-cli-error": "^4.0.0",
    "ink": "^6.7.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "is-ci": "^4.1.0",
    "is-interactive": "^2.0.0",
    "is-unicode-supported": "^2.1.0",
    "js-tiktoken": "^1.0.21",
    "just-bash": "^1.0.0",
    "katex": "^0.17.0",
    "marked-katex-extension": "^5.1.10",
    "marked-terminal": "^7.3.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "picocolors": "^1.1.0",
    "react": "^19.0.0",
    "serialize-error": "^12.0.0",
    "sharp": "^0.34.5",
    "shiki": "^3.2.1",
    "string-width": "^8.2.0",
    "supports-color": "^10.2.2",
    "supports-hyperlinks": "^4.4.0",
    "terminal-image": "^4.3.0",
    "terminal-size": "^4.0.0",
    "tinyglobby": "^0.2.14",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.2.2",
    "undici": "^7.22.0",
    "uuid": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@mswjs/interceptors": "^0.41.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
